# engine —— 额度池引擎（Python + curl_cffi）
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install --no-cache-dir curl_cffi==0.17.0

COPY engine/server.py /app/server.py

# DZMM_ROOT 指向挂载卷（accounts.json / webstate.json / web_results.jsonl）
ENV DZMM_ROOT=/data
EXPOSE 8787

CMD ["python", "server.py", "--host", "0.0.0.0", "--port", "8787"]
